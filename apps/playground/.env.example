# HTTP port the playground API listens on.
PORT=3001

# Public origin used to build returned asset URLs. Set this when running behind
# a proxy/domain; defaults to http://localhost:${PORT}.
BASE_URL=""

# Required: drives the agent loop AND is forwarded to castfy0-mcp so its
# in-process AI narration works. Without it, narration falls back to templates.
ANTHROPIC_API_KEY=""

# Optional: override the narration model used by castfy0-mcp (default is the
# MCP's built-in default).
NARRATION_MODEL=""

# Convex deployment this worker pulls jobs from. `npx convex dev` in
# packages/backend prints it.
CONVEX_URL=""

# Shared secret proving a caller is the worker, not a browser. Convex functions
# like claimNext/complete/fail check it, so it must ALSO be set on the
# deployment itself:
#   npx convex env set PLAYGROUND_WORKER_SECRET <same value>
# The worker refuses to start without it.
PLAYGROUND_WORKER_SECRET=""

# Set to "false" to run this process as an artifact server only, taking no jobs.
# Only safe once artifacts live in object storage (Phase 2) — until then the
# machine that renders a video is the only one that can serve it.
RUN_WORKER="true"

# NOTE: PLAYGROUND_API_TOKEN is no longer used. /api/generate is gone; work
# arrives through Convex, so there is no public generation endpoint to guard.

# Comma-separated browser origins allowed to call this API, e.g.
# "https://app.castfy.dev,http://localhost:3000". Empty blocks all browser
# origins (non-browser, server-to-server callers are unaffected).
ALLOWED_ORIGINS=""

# Optional: max simultaneous demo generations before returning HTTP 429.
MAX_CONCURRENT_JOBS="2"

# Optional: wall-clock ceiling for a single run, in ms. On expiry the run is
# aborted and its browser torn down, freeing the slot. Default 40 minutes —
# comfortably above the 30-minute render timeout in agent.ts.
JOB_TIMEOUT_MS="2400000"

# Optional: how long SIGTERM waits for in-flight runs before aborting them.
SHUTDOWN_GRACE_MS="60000"

# Optional: absolute path to a castfy0-mcp entrypoint, overriding the resolved
# package. Only needed when running an unpublished local build of the MCP.
CASTFY0_MCP_ENTRY=""

# Unused by the current agent (Anthropic-only); reserved for multi-provider.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# npm auth token for installing the private @yves-developer/castfy0-mcp package.
NODE_AUTH_TOKEN=""
