# This app builds from the repo root, so patterns here are root-relative.
# Keep it in sync with the root .gitignore where they overlap.

**/node_modules
**/.next
**/.turbo
**/dist
**/build

# Rendered demos — hundreds of MB of local scratch, never part of an image.
apps/playground/output

# Secrets must arrive via BuildKit secrets or runtime env, never a layer.
**/.env
**/.env.*
!**/.env.example

.git
.github
.vscode
.claude
**/*.log
**/coverage
