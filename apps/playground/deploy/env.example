# Copy to `.env` next to docker-compose.yml on the droplet. Never commit the
# filled-in copy — `.env*` is gitignored at the repo root.

# --- Convex -----------------------------------------------------------------
# The PRODUCTION deployment URL, not the anonymous local one. Get it from
# `npx convex deploy` in packages/backend.
CONVEX_URL="https://your-deployment.convex.cloud"

# Must match the value set on the Convex deployment itself:
#   npx convex env set PLAYGROUND_WORKER_SECRET <value> --prod
# The worker refuses to start without it, and Convex rejects its mutations if
# the two disagree.
PLAYGROUND_WORKER_SECRET=""

# --- Anthropic --------------------------------------------------------------
# Drives the agent loop and is forwarded to castfy0-mcp for narration.
ANTHROPIC_API_KEY=""

# --- Public identity --------------------------------------------------------
# The HTTPS origin Caddy serves. Artifact URLs are built from this, so if it is
# wrong or http://, every job "succeeds" while returning URLs no browser will
# load. Must match the hostname in the Caddyfile.
BASE_URL="https://media.example.com"

# Dashboard origin(s), comma-separated. Empty blocks all browser origins.
ALLOWED_ORIGINS="https://app.example.com"

# --- Capacity ---------------------------------------------------------------
# Roughly 1 vCPU and 1-1.5GB per concurrent job. On a 4GB / 2 vCPU droplet, 2.
MAX_CONCURRENT_JOBS="2"

# Wall-clock ceiling for one run (ms). Default 40 minutes.
JOB_TIMEOUT_MS="2400000"

# How long SIGTERM waits for in-flight runs before aborting them. Keep below
# the compose `stop_grace_period` (90s) or Docker kills the drain.
SHUTDOWN_GRACE_MS="60000"

# --- Build-time only --------------------------------------------------------
# Read from the shell environment by docker compose, not from this file, and
# mounted as a BuildKit secret. Export it before building:
#   export NODE_AUTH_TOKEN=...
# NODE_AUTH_TOKEN=
