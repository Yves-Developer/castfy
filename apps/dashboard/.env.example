# Origin of the playground demo-recording service. Server-side only — the
# browser now talks to the same-origin proxy at app/api/generate/route.ts, so
# this value is never shipped in the client bundle.
#
# NOTE: this default (4000) is inherited from the previous client-side constant.
# apps/playground/.env.example documents 3001 as that service's default port —
# set this explicitly to whichever you actually run.
PLAYGROUND_API_URL="http://localhost:4000"

# Must match PLAYGROUND_API_TOKEN in apps/playground/.env. The proxy attaches it
# as `Authorization: Bearer <token>` on every forwarded request.
#
# Do NOT prefix this with NEXT_PUBLIC_ — that would inline it into the client
# bundle and defeat the entire point of the proxy.
PLAYGROUND_API_TOKEN=""
